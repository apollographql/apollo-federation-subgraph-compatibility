{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "include": ["./src/**/*"]
}
