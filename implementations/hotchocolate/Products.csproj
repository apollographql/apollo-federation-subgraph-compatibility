<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(ImplicitUsings)' == 'enable'">
    <Using Include="Products" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApolloGraphQL.HotChocolate.Federation only supports HotChocolate 13.5.x/13.6.x -->
    <PackageReference Include="HotChocolate.AspNetCore" Version="13.6.1" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="13.6.1" />
    <!-- pin patched parser (GHSA-qr3m-xw4c-jqw3, fixed in 13.9.16) -->
    <PackageReference Include="HotChocolate.Language" Version="13.9.17" />
    <PackageReference Include="ApolloGraphQL.HotChocolate.Federation" Version="1.3.0" />
  </ItemGroup>

</Project>
