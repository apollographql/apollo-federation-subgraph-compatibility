{
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.34",
        "nuwave/lighthouse": "^6.71",
        "google/protobuf": "^5.36.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
